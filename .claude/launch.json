{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "bunx next build && bunx next start -p 3100"
      ],
      "port": 3100
    }
  ]
}
